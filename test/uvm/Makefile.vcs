
# VCS Makefile for the PIPE 7.1 MAC-facing bridge UVM environment (closure-plan items 8+).
# Authored-and-review-validated: VCS/UVM 1.2 is not run in the OSS environment (no VCS here);
# the Verilator gate validates the RTL + the DUT wiring (`make lint` at the repo root builds
# pipe7_mac_dut). Compile/run this under VCS where available.

VCS = vcs -sverilog -ntb_opts uvm-1.2 \
      -timescale=1ns/1ps \
      -debug_access+all \
      -kdb -lca \
      +incdir+../../src \
      +incdir+. \
      +incdir+seq_lib

# Compile order: package -> RTL cores -> integrated bridge -> interfaces -> DUT -> UVM pkg ->
# seq_lib -> top. Retargeted at the integrated bridge (item 22): the DUT wraps
# ucie_rdi_to_pipe7_mac_bridge and the top adds the aux Gen6-wide RX datapath.
SRCS = ../../src/pipe7_pkg.sv \
       ../../src/pipe7_mac_ctrl_fsm.sv \
       ../../src/pipe7_tx_framer.sv \
       ../../src/pipe7_rx_deframer.sv \
       ../../src/pipe7_tx_framer_gb.sv \
       ../../src/pipe7_rx_deframer_gb.sv \
       ../../src/pipe7_gen6_datapath.sv \
       ../../src/pipe7_mac_datapath.sv \
       ../../src/pipe7_mac_datapath_ra.sv \
       ../../src/pipe7_msgbus_master.sv \
       ../../src/pipe7_regfile.sv \
       ../../src/pipe7_rdi_ingress.sv \
       ../../src/pipe7_rdi_egress.sv \
       ../../src/pipe7_cdc_elastic_buf.sv \
       ../../src/ucie_rdi_to_pipe7_mac_bridge.sv \
       ucie_rdi_if.sv \
       pipe7_ctrl_if.sv \
       pipe7_msgbus_if.sv \
       pipe7_mac_if.sv \
       pipe7_gen6_rx_if.sv \
       pipe7_mac_dut.sv \
       pipe7_mac_pkg.sv \
       seq_lib/pipe7_seq_lib.sv \
       uvm_test_top.sv

all: compile run

compile:
	$(VCS) $(SRCS) -l compile.log

# Default: the combined datapath + control + message-bus test. Override TEST for the others
# (pipe7_mac_sanity_test | pipe7_ctrl_test | pipe7_msgbus_test | pipe7_rx_test | pipe7_full_test).
TEST ?= pipe7_full_test
run:
	./simv +UVM_TESTNAME=$(TEST) -l sim.log

pdf:
	pandoc README.md -o UVM_README.pdf --toc --number-sections

clean:
	rm -rf simv* csrc DVEfiles inter.vpd ucli.key compile.log sim.log
	rm -rf stack.info.* .vdb UVM_README.pdf verdi* novas*
