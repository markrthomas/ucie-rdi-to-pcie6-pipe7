# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=ucie-rdi-to-pcie6-pipe7
GH_REPO=markrthomas/ucie-rdi-to-pcie6-pipe7
DUT_TOP=ucie_rdi_to_pipe7_mac_bridge

RTL_DIR=src
TB_DIR=test

DV_ENVS="verilator cocotb uvm"
GATE_TARGET=quick
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="formal upf docs-check report-check"
HEAVY_TARGETS="regress regress-all regress-cov uvm formal ci"

MUTATION_FILE=src/pipe7_tx_framer.sv
MUTATION_HINT="invert one valid/ready qualifier or corrupt one data bit on the main datapath"

RR_DIR=test/random
RR_STATUS=bootstrap

METRICS=no
